# Uploaded files: images only, never executed as scripts
Options -Indexes -ExecCGI
Require all denied
<FilesMatch "\.(jpe?g|png|gif|webp)$">
    Require all granted
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
